# Run the demo's services and workers against Temporal Cloud.
# 1. Create the namespaces and endpoints (see deploy/terraform/main.tf).
# 2. Ask for Standalone Nexus Operations to be enabled on the caller namespace (pre-release).
# 3. cp config/cloud.env.example cloud.env, fill in the values, then: make up-cloud
#    (cloud.env is git-ignored. Never commit an API key.)

TEMPORAL_PROFILE=cloud
TEMPORAL_ADDRESS=us-east-1.aws.api.temporal.io:7233   # your region's endpoint for API-key auth
TEMPORAL_API_KEY=replace-me

# <namespace>.<account-id>
CALLER_NAMESPACE=nexus-demo-callers.ACCOUNT
NOTIFY_NAMESPACE=nexus-demo-notification.ACCOUNT
TASKS_NAMESPACE=nexus-demo-tasks.ACCOUNT
BILLING_NAMESPACE=nexus-demo-callers.ACCOUNT          # the team workflow can share the caller namespace

NEXUS_ENV=dev   # endpoint names: notifications-dev, task-center-dev

TEMPORAL_UI_URL=https://cloud.temporal.io
GATEWAY_OWNER_VIEW=false   # callers normally can't read the handler namespaces
